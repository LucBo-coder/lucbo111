{
  "name": "pokemon-survivor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "e2e:server": "playwright test --config playwright.server.config.ts"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "phaser": "^3.88.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
