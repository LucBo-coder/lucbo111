# Authoritative server settings (copy to your process manager / container env; contains no secrets).
# Every value below is the default used when the variable is unset.
HOST=0.0.0.0
PORT=8787
# SQLite file (canonical saves, accounts, social, events, audit log). Back it up; WAL mode is on.
DB_PATH=server/data/game.db
# Regions that run on this server (each has its own event scheduler + Alpha).
REGIONS=ca-mau,an-giang,can-tho
# World event cycle: start-to-start interval, duration, and the "WORLD EVENT INCOMING" lead time.
# Production must keep the 10-minute cycle (600000). Shorter values are for local testing only.
EVENT_INTERVAL_MS=600000
EVENT_DURATION_MS=480000
EVENT_ANNOUNCE_MS=60000
ALPHA_RESPAWN_MS=45000
AUTH_TIMEOUT_MS=10000
# Login/register attempts per IP per minute.
AUTH_PER_MINUTE=12
# Presence broadcast period (10 Hz) and interest-management radius in world pixels.
PRESENCE_INTERVAL_MS=100
RELEVANCE_RADIUS=1600
# Players per channel before a region opens the next channel.
MAX_PER_CHANNEL=30
SWITCH_COOLDOWN_MS=1500
VERBOSE=true
