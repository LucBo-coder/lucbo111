  "signs": [
    {
      "x": 83,
      "y": 88,
      "text": [
        "KHÔNG GIAN ULTRA",
        "Những hòn đảo trôi giữa khoảng không. Mỗi cổng quanh Siêu Đô Thị dẫn tới một thế giới có Ultra Beast riêng.",
        "Ultra Beast ngủ cho tới khi thế giới của nó bị khuấy động. Hạ Nihilego, Xurkitree và Guzzlord để đánh thức thứ ở đỉnh Siêu Đô Thị."
      ]
    }
  ],
  "npcs": [
    {
      "id": "ultra-nurse",
      "name": "Y tá Đội Trinh Sát",
      "sprite": "girl",
      "role": "nurse",
      "x": 84,
      "y": 85,
      "lines": [
        "Đường về xa lắm, để tôi chữa cho đội của bạn."
      ]
    },
    {
      "id": "ultra-recon",
      "name": "Đội Trinh Sát Ultra",
      "sprite": "wizard",
      "x": 73,
      "y": 88,
      "lines": [
        "Ánh sáng ở thế giới chúng tôi đã bị nuốt mất… Bạn tới được đây là nhờ Ultra Wormhole.",
        "Đừng bước ra mép đảo: bên dưới chỉ có khoảng không. Muốn sang đảo khác thì đi qua các cổng quanh Siêu Đô Thị — hoặc bay, nếu Pokémon của bạn đủ khỏe.",
        "Những vết nứt nhỏ ở đây còn kéo cả huyền thoại từ các vùng đất xa xôi tới.",
        "Muốn về thì bước vào Ultra Wormhole ngay sau lưng tôi."
      ]
    },
    {
      "id": "ultra-nurse-wilds",
      "name": "Y tá Đội Trinh Sát",
      "sprite": "girl",
      "role": "nurse",
      "x": 83,
      "y": 131,
      "lines": [
        "Ánh sáng ở đây yếu lắm… nghỉ một chút rồi hãy đi tiếp."
      ]
    }
  ],
