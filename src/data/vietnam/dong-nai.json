 "signs": [
  { "x": 62, "y": 71, "text": ["THÀNH PHỐ BIÊN HÒA", "Phía bắc: Vườn quốc gia Cát Tiên, Bàu Sấu, đồi điều Bình Phước · Phía tây: Bửu Long · Phía đông: thác Giang Điền · Phía nam: sông Đồng Nai."] },
  { "x": 42, "y": 38, "text": ["VƯỜN QUỐC GIA CÁT TIÊN", "Rừng nhiệt đới nguyên sinh: bò tót, vượn đen má vàng, cá sấu Xiêm ở Bàu Sấu. Đi nhẹ, nói khẽ."] },
  { "x": 22, "y": 68, "text": ["KHU DU LỊCH BỬU LONG", "Núi đá, hồ Long Ẩn và chùa Bửu Phong trên đỉnh. Người ta gọi là Hạ Long thu nhỏ."] }
 ],
 "npcs": [
  { "id": "dn-guide", "name": "Cô Tư Biên Hòa", "sprite": "girl", "x": 61, "y": 64, "lines": [
    "Chào mừng tới Đồng Nai! Phía bắc là rừng Cát Tiên, rộng mênh mông.",
    "Mấy bữa nay đàn bò tót bỏ rừng chạy ra rẫy điều, húc đổ cả chòi canh. Lạ lắm.",
    "Kiểm lâm Cát Tiên biết rõ chuyện này, con lên đó hỏi thử."] },
  { "id": "dn-ranger", "name": "Kiểm lâm Cát Tiên", "sprite": "ranger", "x": 34, "y": 32, "lines": [
    "Bò tót Cát Tiên là loài bò rừng lớn nhất thế giới đó.",
    "Con đầu đàn đang nổi giận vì có người đặt bẫy trong rừng. Phải có ai đủ sức làm nó nguôi."] },
  { "id": "dn-croc", "name": "Chú Sáu Bàu Sấu", "sprite": "villager", "x": 84, "y": 27, "lines": [
    "Bàu Sấu có cá sấu Xiêm hoang dã, giống quý lắm.",
    "Đứng xa mép nước ra con, tụi nó nằm im như khúc gỗ đó."] },
  { "id": "dn-cashew", "name": "Cô Năm hạt điều", "sprite": "girl", "x": 110, "y": 19, "lines": [
    "Hạt điều Bình Phước ngon nhất nước! Rang muối, rang tỏi, cái gì cũng có.",
    "Đàn bò tót ra phá rẫy điều mấy đêm rồi, cô sợ quá."] },
  { "id": "dn-monk", "name": "Thầy chùa Bửu Phong", "sprite": "elder", "x": 20, "y": 62, "lines": [
    "Chùa Bửu Phong trên núi đá này có từ thế kỷ mười bảy.",
    "Đá Biên Hòa là đá ong, đá xanh, người ta tạc thành tượng, làm cối xay."] },
  { "id": "dn-falls", "name": "Anh hướng dẫn Giang Điền", "sprite": "youngster", "x": 108, "y": 70, "lines": [
    "Thác Giang Điền đẹp nhất mùa mưa, nước trắng xóa.",
    "Có tay dân phượt cứ đứng trên mỏm đá thách đấu khách."] },
  { "id": "dn-ferry", "name": "Lái đò sông Đồng Nai", "sprite": "villager", "x": 42, "y": 94, "lines": [
    "Sông Đồng Nai chảy về Sài Gòn rồi ra biển Cần Giờ.",
    "Lưới bỏ hoang dưới sông nhiều quá, cá mắc chết cả bầy."] }
 ],
