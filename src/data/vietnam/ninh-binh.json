 "signs": [
  { "x": 62, "y": 60, "text": ["CỐ ĐÔ HOA LƯ", "Kinh đô đầu tiên của nhà nước phong kiến tập quyền. Phía tây bắc: Hang Múa · Phía bắc: Tràng An · Phía đông: Bái Đính · Phía tây: Cúc Phương · Phía nam: Tam Cốc."] },
  { "x": 36, "y": 20, "text": ["HANG MÚA", "Năm trăm bậc đá lên đỉnh núi, tượng rồng đá uốn quanh, nhìn xuống đồng lúa Tam Cốc."] },
  { "x": 60, "y": 32, "text": ["TRÀNG AN", "Thuyền nan len qua hang tối và núi đá vôi. Di sản thế giới kép đầu tiên của Việt Nam."] }
 ],
 "npcs": [
  { "id": "nb-guide", "name": "Cô Thắm Hoa Lư", "sprite": "girl", "x": 70, "y": 60, "lines": [
    "Chào mừng tới Ninh Bình! Ăn miếng cơm cháy giòn đã con.",
    "Mấy đêm nay trên đỉnh Hang Múa có con rồng ba đầu, tượng rồng đá nứt cả rồi.",
    "Cô lái đò Tràng An đi khắp hang, con ra hỏi thử."] },
  { "id": "nb-boat", "name": "Cô lái đò Tràng An", "sprite": "girl", "x": 50, "y": 30, "lines": [
    "Chèo đò bằng chân mấy chục năm rồi, hang nào cô cũng thuộc.",
    "Trong hang có tiếng gầm vọng ra từ phía Hang Múa, ba tiếng một lúc."] },
  { "id": "nb-mua", "name": "Người giữ bậc đá Hang Múa", "sprite": "villager", "x": 36, "y": 30, "lines": [
    "Năm trăm bậc lên đỉnh, ai lên tới cũng thở không ra hơi.",
    "Con rồng ba đầu đậu trên tượng rồng đá, ai lên gần là nó phun lửa."] },
  { "id": "nb-monk", "name": "Sư chùa Bái Đính", "sprite": "elder", "x": 108, "y": 30, "lines": [
    "Chùa Bái Đính có pho tượng Phật bằng đồng lớn nhất châu Á.",
    "Rồng ba đầu kia không ác, nó chỉ giận vì núi đá bị nổ mìn khai thác."] },
  { "id": "nb-ranger", "name": "Kiểm lâm Cúc Phương", "sprite": "ranger", "x": 14, "y": 60, "lines": [
    "Cúc Phương là vườn quốc gia đầu tiên của Việt Nam, có cây chò ngàn năm.",
    "Bầy rắn độc vây con sóc bay ở góc rừng, anh chưa tới kịp."] },
  { "id": "nb-farmer", "name": "Bác nông dân Tam Cốc", "sprite": "farmer", "x": 60, "y": 86, "lines": [
    "Mùa lúa chín Tam Cốc vàng rực giữa núi đá, đẹp nhất năm.",
    "Rồng gầm làm đàn vịt chạy tán loạn khắp đồng."] },
  { "id": "nb-hist", "name": "Nhà nghiên cứu cố đô", "sprite": "elder", "x": 84, "y": 48, "lines": [
    "Vua Đinh Tiên Hoàng dẹp loạn mười hai sứ quân, lập kinh đô Hoa Lư năm 968.",
    "Truyền thuyết kể rồng mẹ dẫn đàn rồng con xuống giúp dân đánh giặc, nên có tên Ninh Bình — Hạ Long cạn."] }
 ],
