   ]
  },
  {
   "id": "tv-board",
   "name": "Bảng nhiệm vụ Trà Vinh",
   "sprite": "board",
   "x": 66,
   "y": 49,
   "lines": [
    "Bảng nhiệm vụ: chưa có yêu cầu mới."
   ]
  },
  {
   "id": "tv-elder",
   "name": "Ông Ba Thạch",
   "sprite": "elder",
   "x": 30,
   "y": 79,
   "lines": [
    "Ông bà kể hồi xưa hai phe thi nhau đắp ao, phe phụ nữ do bà Om dẫn đầu thắng, nên ao mang tên Ao Bà Om.",
    "Mấy cây dầu già này đứng đây cả trăm năm rồi."
   ]
  },
  {
   "id": "tv-achar",
   "name": "Ông Achar Kim",
   "sprite": "elder",
   "x": 64,
   "y": 70,
   "lines": [
    "Achar là người lo việc chùa giúp các sư. Chiều nào cò cũng về đầy cây — con đứng xa mà ngắm."
   ]
  },
  {
   "id": "tv-stork",
   "name": "Cô Năm ngắm cò",
   "sprite": "girl",
   "x": 76,
   "y": 72,
   "lines": [
    "Mấy bữa nay đàn cò về ít hẳn. Nghe nói bên rừng dầu có tiếng rễ cây kêu răng rắc ban đêm..."
   ]
  },
  {
   "id": "tv-farmer",
   "name": "Chú Tư dừa sáp",
   "sprite": "farmer",
   "x": 24,
   "y": 24,
   "lines": [
    "Cả trăm trái dừa mới có vài trái sáp. Dừa sáp Cầu Kè cơm dẻo, ăn với đường là hết sảy."
   ]
  },
  {
   "id": "tv-seller",
   "name": "Cô Út bán nghêu",
   "sprite": "villager",
   "x": 102,
   "y": 58,
   "lines": [
    "Nghêu Ba Động luộc sả nè! Mà rác dạt lên bãi nhiều quá, khách tới thấy kỳ."
   ]
  },
  {
   "id": "tv-ranger",
   "name": "Anh kiểm lâm Duyên Hải",
   "sprite": "youngster",
   "x": 50,
   "y": 104,
   "lines": [
    "Rừng đước chắn sóng cho cả vùng ven biển. Đi đường ven kênh thôi, đừng giẫm cây con."
   ]
  }
