 "signs": [
  {
   "x": 54,
   "y": 50,
   "text": [
    "THÀNH PHỐ TRÀ VINH",
    "Thành phố nhiều cây cổ thụ, nơi người Kinh, Khmer và Hoa cùng sinh sống. Phía tây nam: Ao Bà Om, Chùa Âng · Phía nam: Chùa Hang · Phía đông: biển Ba Động · Phía tây: đường về Vĩnh Long."
   ]
  },
  {
   "x": 40,
   "y": 62,
   "text": [
    "AO BÀ OM",
    "Ao nước hình gần vuông, bờ ao trồng những hàng cây dầu cổ thụ rễ nổi lên mặt đất. Bên cạnh là Chùa Âng và Bảo tàng Văn hóa Khmer.",
    "(Thần Cây Dầu trong game là sinh vật giả tưởng.)"
   ]
  },
  {
   "x": 68,
   "y": 62,
   "text": [
    "CHÙA HANG",
    "Ngôi chùa Khmer có cổng vòm như hang, khuôn viên nhiều cây cao — nơi hàng ngàn con cò về trú mỗi chiều.",
    "Xin giữ yên lặng, không làm kinh động đàn cò."
   ]
  },
  {
   "x": 98,
   "y": 44,
   "text": [
    "BIỂN BA ĐỘNG",
    "Bãi biển cát mịn của Trà Vinh ở vùng Duyên Hải. ← Thành phố · ↓ Rừng ngập mặn Duyên Hải"
   ]
  },
  {
   "x": 26,
   "y": 38,
   "text": [
    "VƯỜN DỪA CẦU KÈ",
    "Cầu Kè là quê của dừa sáp — trái dừa cơm dày, dẻo, nước sệt."
   ]
  },
  {
   "x": 64,
   "y": 94,
   "text": [
    "RỪNG NGẬP MẶN DUYÊN HẢI",
    "Rừng đước, rừng mắm chắn sóng ven biển. Đi đường ven kênh, cẩn thận bùn lầy."
   ]
  }
 ],
 "npcs": [
  {
   "id": "tv-guide",
   "name": "Hướng dẫn viên Thảo",
   "sprite": "girl",
   "x": 60,
   "y": 49,
   "lines": [
    "Chào mừng tới Trà Vinh — thành phố của những hàng cây cổ thụ!",
    "Ao Bà Om, Chùa Âng, Chùa Hang, biển Ba Động, dừa sáp Cầu Kè đều có thật. Thần Cây Dầu và những chuyện lạ trong game là giả tưởng."
   ]
  },
  {
   "id": "shopkeeper",
   "name": "Cô bán hàng Mai",
   "sprite": "villager",
   "x": 61,
   "y": 43,
   "lines": [
