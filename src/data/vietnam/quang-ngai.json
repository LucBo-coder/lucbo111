 "signs": [
  { "x": 64, "y": 54, "text": ["THÀNH PHỐ QUẢNG NGÃI", "Đất núi Ấn sông Trà. Phía tây: Kon Tum, Măng Đen · Phía bắc: núi Ngọc Linh · Phía đông: biển Lý Sơn · Phía nam: Sa Huỳnh."] },
  { "x": 18, "y": 84, "text": ["LÀNG KON KLOR", "Nhà rông cao vút của người Ba Na bên cầu treo sông Đắk Bla."] },
  { "x": 100, "y": 36, "text": ["BẾN TÀU LÝ SƠN", "Đảo tỏi ngoài khơi, có Cổng Tò Vò và chùa Hang. Sóng lớn mấy tuần nay, tàu không chạy."] }
 ],
 "npcs": [
  { "id": "qn-guide", "name": "Bác Tư Quảng Ngãi", "sprite": "elder", "x": 70, "y": 54, "lines": [
    "Chào mừng tới Quảng Ngãi! Ăn chén cá bống kho chưa con?",
    "Tàu ra Lý Sơn ngưng chạy cả tháng rồi. Đêm nào ngư dân cũng thấy bóng mỏ neo dưới nước.",
    "Anh lái tàu ở bến biết rõ, con ra hỏi."] },
  { "id": "qn-ferry", "name": "Anh lái tàu Lý Sơn", "sprite": "villager", "x": 100, "y": 40, "lines": [
    "Có cái mỏ neo cũ trôi dưới đáy, kéo tàu lật mấy chiếc rồi.",
    "Ông bà nói đó là hồn mấy chiếc thuyền đắm, giận vì biển đầy rác."] },
  { "id": "qn-garlic", "name": "Cô trồng tỏi Lý Sơn", "sprite": "girl", "x": 104, "y": 72, "lines": [
    "Tỏi Lý Sơn trồng trên cát san hô, thơm nhất nước đó.",
    "Tàu không chạy, tỏi kẹt ngoài đảo, buồn lắm con."] },
  { "id": "qn-bana", "name": "Già làng Kon Klor", "sprite": "elder", "x": 16, "y": 76, "lines": [
    "Nhà rông là nơi cả làng họp, mái cao để thần linh nghe thấy.",
    "Ngày xưa người Sa Huỳnh chôn người chết trong chum, gửi linh hồn về biển."] },
  { "id": "qn-pine", "name": "Kiểm lâm Măng Đen", "sprite": "ranger", "x": 30, "y": 26, "lines": [
    "Măng Đen là Đà Lạt thứ hai, thông xanh với hồ nước.",
    "Có tay đốn gỗ lén trong rừng, anh chưa bắt được."] },
  { "id": "qn-ginseng", "name": "Người trồng sâm Ngọc Linh", "sprite": "farmer", "x": 60, "y": 16, "lines": [
    "Sâm Ngọc Linh là quốc bảo, mọc dưới tán rừng trên 1.500 mét.",
    "Có người lạ lên núi đào trộm sâm, chú canh cả đêm."] },
  { "id": "qn-salt", "name": "Diêm dân Sa Huỳnh", "sprite": "villager", "x": 70, "y": 90, "lines": [
    "Ruộng muối Sa Huỳnh trắng xóa, nắng càng gắt muối càng ngon.",
    "Ở đây đào được chum gốm của người Sa Huỳnh xưa đó."] }
 ],
