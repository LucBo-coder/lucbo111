 "signs": [
  { "x": 62, "y": 58, "text": ["THÀNH PHỐ CAO BẰNG", "Non nước Cao Bằng. Phía tây bắc: động Ngườm Ngao · Phía bắc: thác Bản Giốc · Phía tây: Pác Bó · Phía nam: hồ Thang Hen · Phía đông: đèo Mã Phục."] },
  { "x": 62, "y": 26, "text": ["THÁC BẢN GIỐC", "Thác nước tự nhiên lớn nhất Đông Nam Á, nước sông Quây Sơn đổ trắng xóa ba tầng."] },
  { "x": 28, "y": 14, "text": ["ĐỘNG NGƯỜM NGAO", "Tiếng Tày nghĩa là Hang Hổ. Ngày xưa hổ về đây trú, dân bản gọi tên như thế."] }
 ],
 "npcs": [
  { "id": "cb-guide", "name": "Chị Mai Cao Bằng", "sprite": "girl", "x": 70, "y": 58, "lines": [
    "Chào mừng tới Cao Bằng! Ăn bát bánh cuốn canh nóng đã em.",
    "Mấy đêm nay trong động Ngườm Ngao có tiếng hổ gầm, lửa lóe sáng cửa hang.",
    "Già làng Tày ở chân núi biết chuyện hang hổ, em qua hỏi."] },
  { "id": "cb-elder", "name": "Già làng Tày", "sprite": "elder", "x": 34, "y": 30, "lines": [
    "Ngườm Ngao là hang hổ. Ông bà kể có Hổ Lửa giữ hang, trăm năm mới hiện.",
    "Người ta mang loa đài vào hang, ồn ào cả ngày. Hổ Lửa thức dậy rồi."] },
  { "id": "cb-falls", "name": "Cô lái bè Bản Giốc", "sprite": "girl", "x": 52, "y": 24, "lines": [
    "Chèo bè tới sát chân thác, bụi nước bay mát rượi.",
    "Đêm qua thấy lửa đỏ trên núi phía tây, chắc từ hang Ngườm Ngao."] },
  { "id": "cb-pacbo", "name": "Cụ giữ di tích Pác Bó", "sprite": "elder", "x": 14, "y": 56, "lines": [
    "Suối Lê-nin trong vắt, núi Các Mác sừng sững.",
    "Rừng đầu nguồn mà mất thì suối cạn, cụ lo lắm."] },
  { "id": "cb-lake", "name": "Người chèo thuyền Thang Hen", "sprite": "villager", "x": 60, "y": 88, "lines": [
    "Hồ Thang Hen có ba mươi sáu hồ nối nhau, mùa mưa nước dâng thông hết.",
    "Rác trôi xuống hồ nhiều, chim nước bỏ đi."] },
  { "id": "cb-pass", "name": "Người Nùng đèo Mã Phục", "sprite": "villager", "x": 116, "y": 40, "lines": [
    "Đèo Mã Phục ngoằn ngoèo, ngựa đi qua cũng phải phục.",
    "Làng rèn Phúc Sen gần đây rèn dao nổi tiếng khắp vùng."] },
  { "id": "cb-smith", "name": "Thợ rèn già Phúc Sen", "sprite": "elder", "x": 84, "y": 46, "lines": [
    "Dao Phúc Sen tôi trong lửa than đá, sắc bén trăm năm.",
    "Lửa rèn cũng không nóng bằng lửa Hổ Thần đâu."] }
 ],
