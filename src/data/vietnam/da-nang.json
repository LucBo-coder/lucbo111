 "signs": [
  { "x": 64, "y": 54, "text": ["THÀNH PHỐ ĐÀ NẴNG", "Thành phố đáng sống bên sông Hàn. Phía tây bắc: Bà Nà, đèo Hải Vân · Phía bắc: Sơn Trà · Phía đông: biển Mỹ Khê · Phía nam: Hội An, Mỹ Sơn."] },
  { "x": 92, "y": 50, "text": ["CẦU RỒNG", "Cây cầu hình rồng vắt qua sông Hàn. Tối cuối tuần rồng phun lửa, phun nước."] },
  { "x": 22, "y": 88, "text": ["THÁNH ĐỊA MỸ SƠN", "Quần thể đền tháp Chăm thờ thần Shiva giữa thung lũng, di sản thế giới."] }
 ],
 "npcs": [
  { "id": "dg-guide", "name": "Chị Hạnh Đà Nẵng", "sprite": "girl", "x": 68, "y": 56, "lines": [
    "Chào mừng tới Đà Nẵng! Ăn tô mì Quảng chưa em?",
    "Mấy đêm nay có con rồng thật bay quanh cầu Rồng, phun lửa cháy cả bờ sông.",
    "Kiểm lâm trên Sơn Trà thấy nó đáp xuống núi, em lên hỏi thử."] },
  { "id": "dg-sontra", "name": "Kiểm lâm Sơn Trà", "sprite": "ranger", "x": 60, "y": 20, "lines": [
    "Sơn Trà là nhà của voọc chà vá chân nâu, nữ hoàng linh trưởng đó.",
    "Con rồng xanh đáp trên đỉnh núi, đêm nào cũng gầm về phía thành phố."] },
  { "id": "dg-bana", "name": "Hướng dẫn viên Cầu Vàng", "sprite": "youngster", "x": 30, "y": 22, "lines": [
    "Cầu Vàng có đôi bàn tay đá khổng lồ nâng đỡ, đẹp lắm.",
    "Từ trên này nhìn thấy cả đèo Hải Vân, đường ra Huế đó."] },
  { "id": "dg-hoian", "name": "Cô bán đèn lồng Hội An", "sprite": "girl", "x": 70, "y": 80, "lines": [
    "Đêm rằm phố cổ tắt đèn điện, chỉ thắp đèn lồng, thả hoa đăng trên sông Hoài.",
    "Ông bà kể rồng ưa ánh lửa, đèn lồng sáng thì rồng hiền."] },
  { "id": "dg-myson", "name": "Nhà khảo cổ Mỹ Sơn", "sprite": "elder", "x": 20, "y": 78, "lines": [
    "Người Chăm xây tháp không dùng vữa, đến giờ vẫn chưa ai biết hết bí mật.",
    "Trên phù điêu có khắc Makara, con thủy quái nửa rồng giữ cửa đền."] },
  { "id": "dg-beach", "name": "Cứu hộ Mỹ Khê", "sprite": "villager", "x": 104, "y": 60, "lines": [
    "Mỹ Khê là một trong những bãi biển đẹp nhất hành tinh đó nha.",
    "Khách đông thì rác nhiều, rùa biển không dám lên bờ."] },
  { "id": "dg-marble", "name": "Thợ đá Non Nước", "sprite": "hiker", "x": 102, "y": 90, "lines": [
    "Làng đá Non Nước dưới chân Ngũ Hành Sơn, đục tượng mấy trăm năm rồi.",
    "Trong núi có động Huyền Không, nắng chiếu xuống như đèn sân khấu."] }
 ],
