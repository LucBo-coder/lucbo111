 "signs": [
  { "x": 62, "y": 66, "text": ["THÀNH PHỐ ĐÀ LẠT", "Thành phố ngàn hoa, quanh năm mát lạnh. Phía bắc: đồi thông, núi Langbiang · Phía tây: làng hoa Vạn Thành · Phía đông: đồi chè Cầu Đất · Phía nam: hồ Xuân Hương, đồi cát Mũi Né."] },
  { "x": 26, "y": 20, "text": ["NÚI LANGBIANG", "Nóc nhà Đà Lạt. Người K'Ho kể chuyện tình chàng Lang và nàng Biang hóa thành hai ngọn núi."] },
  { "x": 50, "y": 102, "text": ["ĐỒI CÁT MŨI NÉ", "Cát đỏ, cát trắng đổi hình theo gió. Đi trên đồi cát nhớ mang nước."] }
 ],
 "npcs": [
  { "id": "ld-guide", "name": "Chị Hoa Đà Lạt", "sprite": "girl", "x": 62, "y": 58, "lines": [
    "Chào mừng lên Đà Lạt! Mặc thêm áo ấm nha, ở đây lạnh lắm.",
    "Năm nay hoa ở làng Vạn Thành héo hết trơn trước Tết. Ai cũng lo.",
    "Bà Ba ở làng hoa phía tây biết rõ chuyện, con qua hỏi bà."] },
  { "id": "ld-gardener", "name": "Bà Ba làng hoa", "sprite": "girl", "x": 22, "y": 64, "lines": [
    "Làng hoa này trồng hồng, cúc, cẩm tú cầu, hoa nào cũng đẹp.",
    "Người ta nói có Thần Hoa sống trong thung lũng phía bắc làng. Thần buồn thì hoa héo."] },
  { "id": "ld-kho", "name": "Già làng K'Ho", "sprite": "elder", "x": 30, "y": 22, "lines": [
    "Chàng Lang và nàng Biang yêu nhau mà không được ở bên nhau, hóa thành núi.",
    "Thần Hoa là nước mắt của nàng Biang. Thần mà khóc thì hoa cả vùng héo theo."] },
  { "id": "ld-tea", "name": "Chú Tám đồi chè", "sprite": "farmer", "x": 108, "y": 57, "lines": [
    "Chè Cầu Đất trồng từ thời Pháp, đồi chè xanh tới tận chân mây.",
    "Sương sớm trên đồi chè đẹp nhất, mà lạnh cóng tay."] },
  { "id": "ld-pine", "name": "Anh kiểm lâm rừng thông", "sprite": "ranger", "x": 90, "y": 28, "lines": [
    "Rừng thông Đà Lạt reo vi vu suốt ngày.",
    "Có đàn Pokémon nai bị chó sói đuổi trong rừng, anh lo quá."] },
  { "id": "ld-muine", "name": "Cô bán nước mắm Phan Thiết", "sprite": "girl", "x": 90, "y": 101, "lines": [
    "Nước mắm Phan Thiết thơm nhất nước! Mua về chấm gì cũng ngon.",
    "Đồi cát này gió thổi cả ngày, cát bay rát mặt lắm con."] },
  { "id": "ld-lake", "name": "Ông đạp vịt hồ Xuân Hương", "sprite": "villager", "x": 48, "y": 80, "lines": [
    "Thuê thuyền đạp vịt không con? Hồ Xuân Hương chiều nay đẹp lắm.",
    "Rác trôi dạt vô bờ hồ nhiều quá, ông nhặt không xuể."] }
 ],
