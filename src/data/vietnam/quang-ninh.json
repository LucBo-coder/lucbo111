 "signs": [
  { "x": 62, "y": 60, "text": ["THÀNH PHỐ HẠ LONG", "Phía tây bắc: Yên Tử · Phía bắc: mỏ than Cẩm Phả · Phía đông: Bãi Cháy, vịnh Hạ Long · Phía tây: Vân Đồn · Phía nam: rừng ngập mặn."] },
  { "x": 96, "y": 40, "text": ["VỊNH HẠ LONG", "Gần hai ngàn hòn đảo đá vôi. Truyền thuyết kể Rồng Mẹ dẫn đàn rồng con xuống phun ngọc chống giặc, ngọc hóa thành đảo."] },
  { "x": 18, "y": 30, "text": ["YÊN TỬ", "Đất Phật, nơi vua Trần Nhân Tông lập Thiền phái Trúc Lâm. Chùa Đồng trên đỉnh mây."] }
 ],
 "npcs": [
  { "id": "ql-guide", "name": "Chị Hạ Hạ Long", "sprite": "girl", "x": 70, "y": 60, "lines": [
    "Chào mừng tới Hạ Long! Ăn miếng chả mực giã tay đã em.",
    "Mấy bữa nay vịnh nổi sóng dữ, có bóng rồng lớn lượn trên trời, tàu du lịch không dám ra.",
    "Anh lái tàu ở Bãi Cháy biết chuyện, em ra hỏi."] },
  { "id": "ql-boat", "name": "Lái tàu du lịch Hạ Long", "sprite": "villager", "x": 104, "y": 44, "lines": [
    "Tui chạy tàu hai chục năm, chưa thấy vịnh dữ vậy.",
    "Có con rồng to như cái tàu bay quanh hòn Gà Chọi, ai tới gần là nó quẫy sóng."] },
  { "id": "ql-monk", "name": "Sư chùa Đồng Yên Tử", "sprite": "elder", "x": 30, "y": 34, "lines": [
    "Rồng Mẹ Hạ Long là rồng hiền, chỉ giận khi vịnh bị ô nhiễm.",
    "Than đá, rác thải đổ ra vịnh nhiều quá, Rồng Mẹ không chịu nổi."] },
  { "id": "ql-miner", "name": "Thợ mỏ Cẩm Phả", "sprite": "hiker", "x": 56, "y": 20, "lines": [
    "Than Quảng Ninh sưởi ấm cả miền Bắc.",
    "Mà nước thải mỏ chảy ra vịnh, tui cũng thấy áy náy."] },
  { "id": "ql-vandon", "name": "Ngư dân Vân Đồn", "sprite": "villager", "x": 14, "y": 60, "lines": [
    "Vân Đồn ngày xưa là thương cảng đầu tiên của Đại Việt.",
    "Bầy chim săn mồi kéo về đầy, chim biển nhỏ trốn hết."] },
  { "id": "ql-mangrove", "name": "Kiểm lâm rừng ngập mặn", "sprite": "ranger", "x": 60, "y": 88, "lines": [
    "Rừng ngập mặn là lá chắn sóng của cả vùng.",
    "Có kẻ chặt đước làm củi, rừng thưa dần."] },
  { "id": "ql-pearl", "name": "Cô nuôi ngọc trai", "sprite": "girl", "x": 104, "y": 80, "lines": [
    "Ngọc trai Hạ Long sáng lắm, nuôi ba năm mới được một viên.",
    "Có con cá đuối bị lưới quấn ở bãi phía nam, cô không gỡ được."] }
 ],
