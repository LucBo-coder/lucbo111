 "signs": [
  { "x": 62, "y": 56, "text": ["THÀNH PHỐ THANH HÓA", "Xứ Thanh. Phía tây bắc: Pù Luông · Phía bắc: suối cá thần Cẩm Lương · Phía đông: biển Sầm Sơn · Phía tây: thành nhà Hồ · Phía nam: hồ Bến En, Lam Kinh."] },
  { "x": 76, "y": 18, "text": ["SUỐI CÁ THẦN CẨM LƯƠNG", "Hàng ngàn con cá dày đặc trong suối, người Mường coi là cá thần, không ai dám bắt."] },
  { "x": 20, "y": 70, "text": ["THÀNH NHÀ HỒ", "Tòa thành đá xây năm 1397, những khối đá nặng hàng chục tấn ghép không cần vữa. Di sản thế giới."] }
 ],
 "npcs": [
  { "id": "th-guide", "name": "Chị Mai xứ Thanh", "sprite": "girl", "x": 70, "y": 56, "lines": [
    "Chào mừng tới xứ Thanh! Ăn chiếc nem chua cho biết.",
    "Suối cá thần Cẩm Lương cạn dần, đàn cá thần bỏ đi đâu hết.",
    "Người giữ suối biết chuyện, em lên hỏi."] },
  { "id": "th-keeper", "name": "Người giữ suối cá thần", "sprite": "elder", "x": 60, "y": 16, "lines": [
    "Đàn cá thần sống ở đây cả ngàn năm, có Nữ Thần Suối che chở.",
    "Người trên nguồn chặt rừng, suối đục, Nữ Thần giận dâng nước cuốn trôi bản."] },
  { "id": "th-terrace", "name": "Cô gái Thái Pù Luông", "sprite": "girl", "x": 30, "y": 12, "lines": [
    "Ruộng bậc thang Pù Luông mùa lúa chín vàng như thang lên trời.",
    "Nước suối đục, lúa trên ruộng vàng úa hết."] },
  { "id": "th-hist", "name": "Nhà sử học thành nhà Hồ", "sprite": "elder", "x": 22, "y": 84, "lines": [
    "Hồ Quý Ly xây thành chỉ trong ba tháng, đá cắt khít tới mức lưỡi dao không lách vào được.",
    "Sử chép: thời đó có rắn thần dưới suối Cẩm Lương phù hộ dân Mường."] },
  { "id": "th-lake", "name": "Ông lái đò Bến En", "sprite": "villager", "x": 60, "y": 90, "lines": [
    "Hồ Bến En có hơn hai chục đảo, rừng nguyên sinh bao quanh.",
    "Lam Kinh gần đây là quê vua Lê Lợi."] },
  { "id": "th-samson", "name": "Ngư dân Sầm Sơn", "sprite": "villager", "x": 104, "y": 70, "lines": [
    "Hòn Trống Mái ở Sầm Sơn là chuyện tình chàng ngư dân và cô gái hóa đá.",
    "Rác trôi vô bãi nhiều quá con ơi."] },
  { "id": "th-bard", "name": "Nghệ nhân trống đồng Đông Sơn", "sprite": "elder", "x": 84, "y": 46, "lines": [
    "Trống đồng Đông Sơn tìm thấy đầu tiên ở xứ Thanh này đó.",
    "Trên mặt trống có hình chim Lạc bay quanh mặt trời."] }
 ],
