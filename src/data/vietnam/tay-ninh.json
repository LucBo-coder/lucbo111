 "signs": [
  { "x": 60, "y": 69, "text": ["THÀNH PHỐ TÂY NINH", "Phía bắc: Núi Bà Đen, nóc nhà Nam Bộ, và hồ Dầu Tiếng · Phía tây: Tòa Thánh Cao Đài · Phía đông: làng nổi Tân Lập · Phía nam: cánh đồng Long An."] },
  { "x": 22, "y": 64, "text": ["TÒA THÁNH TÂY NINH", "Thánh thất của đạo Cao Đài. Mỗi ngày bốn thời cúng, chuông trống vang khắp vùng."] },
  { "x": 66, "y": 38, "text": ["NÚI BÀ ĐEN", "Cao 986 m, nóc nhà Nam Bộ. Đường mòn lên đỉnh qua chùa Bà và những bãi đá lớn."] }
 ],
 "npcs": [
  { "id": "tn-guide", "name": "Chị Sáu Tây Ninh", "sprite": "girl", "x": 61, "y": 63, "lines": [
    "Chào mừng tới Tây Ninh! Nhìn lên phía bắc kìa — Núi Bà Đen đó.",
    "Mấy bữa nay đá trên núi lăn xuống hoài, người ta nói Thần Núi đang giận.",
    "Muốn hiểu chuyện thì ghé Tòa Thánh phía tây hỏi Ông Đạo Chín."] },
  { "id": "tn-monk", "name": "Ông Đạo Chín", "sprite": "elder", "x": 22, "y": 62, "lines": [
    "Tòa Thánh này xây gần trăm năm, mái vàng cột rồng, ai tới cũng được vào.",
    "Núi Bà có thần giữ từ xưa. Ai lên núi mà quấy phá là đá lăn xuống ngay."] },
  { "id": "tn-pilgrim", "name": "Bà hành hương Tư", "sprite": "girl", "x": 84, "y": 27, "lines": [
    "Năm nào bà cũng lên chùa Bà Đen cầu bình an.",
    "Năm nay lên tới lưng chừng đã nghe đá rung. Con có sức thì lên coi giùm bà."] },
  { "id": "tn-boat", "name": "Cô Út Tân Lập", "sprite": "girl", "x": 108, "y": 73, "lines": [
    "Làng nổi Tân Lập là rừng tràm giữa đồng nước, đi xuồng len giữa hàng cây mát rượi.",
    "Có tay lái xuồng hay chặn khách, cô ngán quá."] },
  { "id": "tn-farmer", "name": "Chú Năm ruộng", "sprite": "farmer", "x": 40, "y": 97, "lines": [
    "Lúa Long An thơm lắm con, gạo nấu cơm dẻo mà không dính.",
    "Mùa gặt tới rồi, mà có thằng thợ gặt cứ đòi đấu với ai đi ngang."] },
  { "id": "tn-fisher", "name": "Ông Hai Dầu Tiếng", "sprite": "villager", "x": 46, "y": 32, "lines": [
    "Hồ Dầu Tiếng lớn nhất miền Nam, nước tưới cho cả mấy tỉnh.",
    "Rác trôi vô bờ nhiều quá, cá về ít hẳn."] },
  { "id": "tn-cake", "name": "Cô Bảy bánh tráng", "sprite": "girl", "x": 48, "y": 66, "lines": [
    "Bánh tráng phơi sương Trảng Bàng đây con! Phơi nắng rồi phơi sương mới dẻo.",
    "Cuốn với thịt luộc, rau rừng, chấm mắm nêm — ăn một lần là nhớ."] }
 ],
