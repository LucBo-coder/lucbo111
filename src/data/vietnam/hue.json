 "signs": [
  { "x": 64, "y": 54, "text": ["THÀNH PHỐ HUẾ", "Cố đô bên sông Hương. Phía bắc: Đại Nội · Phía tây: lăng tẩm, chùa Thiên Mụ · Phía đông bắc: phá Tam Giang · Phía nam: Bạch Mã, Lăng Cô."] },
  { "x": 72, "y": 30, "text": ["HOÀNG THÀNH HUẾ", "Kinh đô triều Nguyễn hơn trăm năm. Qua Ngọ Môn là điện Thái Hòa, nơi vua thiết triều."] },
  { "x": 34, "y": 56, "text": ["CHÙA THIÊN MỤ", "Ngôi chùa cổ trên đồi Hà Khê, tháp Phước Duyên bảy tầng soi bóng sông Hương."] }
 ],
 "npcs": [
  { "id": "hu-guide", "name": "Mệ Tôn Nữ", "sprite": "elder", "x": 64, "y": 46, "lines": [
    "Chào mừng tới Huế, con. Ăn tô bún bò cho ấm bụng đã.",
    "Mấy đêm nay trong Đại Nội có tiếng gươm khua, lính canh không dám vô.",
    "Sư chùa Thiên Mụ hiểu chuyện xưa, con qua hỏi thử."] },
  { "id": "hu-monk", "name": "Sư chùa Thiên Mụ", "sprite": "elder", "x": 34, "y": 52, "lines": [
    "Tiếng chuông Thiên Mụ vọng khắp sông Hương mỗi sớm.",
    "Ngày xưa có thanh gươm báu trấn giữ hoàng thành. Gươm có hồn, ai bất kính là gươm giận."] },
  { "id": "hu-mandarin", "name": "Ông giữ Đại Nội", "sprite": "elder", "x": 60, "y": 28, "lines": [
    "Tui giữ Đại Nội bốn chục năm, chưa bao giờ nghe gươm khua như vầy.",
    "Người ta leo trèo, khắc tên lên tường thành... gươm báu giận là phải."] },
  { "id": "hu-tomb", "name": "Người giữ lăng Tự Đức", "sprite": "villager", "x": 14, "y": 30, "lines": [
    "Lăng Tự Đức có hồ Lưu Khiêm, vua ngồi làm thơ bên hồ đó con.",
    "Đêm qua có bóng gươm bay ngang lăng, sáng lấp lánh."] },
  { "id": "hu-lagoon", "name": "Ngư dân phá Tam Giang", "sprite": "villager", "x": 98, "y": 40, "lines": [
    "Phá Tam Giang lớn nhất Đông Nam Á, nuôi sống cả vạn ngư dân.",
    "Sáo, lưới bỏ hoang giăng kín phá, cá không có đường đi."] },
  { "id": "hu-ranger", "name": "Kiểm lâm Bạch Mã", "sprite": "ranger", "x": 30, "y": 86, "lines": [
    "Bạch Mã mây phủ quanh năm, có gà lôi trắng quý lắm.",
    "Bầy chó lửa xuống núi đuổi gà lôi, con giúp anh với."] },
  { "id": "hu-langco", "name": "Cô bán hải sản Lăng Cô", "sprite": "girl", "x": 110, "y": 92, "lines": [
    "Vịnh Lăng Cô đẹp nhất thế giới đó con, có tên trong câu lạc bộ luôn.",
    "Qua đèo Hải Vân là tới Đà Nẵng."] }
 ],
