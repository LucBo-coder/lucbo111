 "signs": [
  { "x": 62, "y": 60, "text": ["THÀNH PHỐ LẠNG SƠN", "Xứ Lạng. Phía tây bắc: núi Tô Thị, động Tam Thanh · Phía bắc: Mẫu Sơn · Phía tây: ải Chi Lăng · Phía nam: đồi hồi · Phía đông: sông Kỳ Cùng."] },
  { "x": 28, "y": 12, "text": ["NÚI TÔ THỊ", "Nàng Tô Thị bồng con đứng chờ chồng đi lính, lâu ngày hóa đá. Đồng Đăng có phố Kỳ Lừa, có nàng Tô Thị, có chùa Tam Thanh."] },
  { "x": 20, "y": 62, "text": ["ẢI CHI LĂNG", "Hẻm núi hiểm trở, nơi Lê Lợi phục binh chém Liễu Thăng năm 1427."] }
 ],
 "npcs": [
  { "id": "ls-guide", "name": "Chị Tày Hoa", "sprite": "girl", "x": 70, "y": 60, "lines": [
    "Chào mừng tới xứ Lạng! Ăn miếng vịt quay mắc mật cho biết.",
    "Mấy đêm nay đá trên núi Tô Thị lăn xuống ầm ầm, tượng nàng Tô Thị như cựa mình.",
    "Bà cụ dưới chân núi kể chuyện nàng rành nhất, em qua hỏi."] },
  { "id": "ls-tothi", "name": "Bà cụ kể chuyện Tô Thị", "sprite": "elder", "x": 34, "y": 32, "lines": [
    "Nàng Tô Thị chờ chồng tới hóa đá, mấy trăm năm vẫn đứng trông.",
    "Người ta leo lên tượng chụp ảnh, khắc tên... nàng không yên được."] },
  { "id": "ls-cave", "name": "Sư chùa Tam Thanh", "sprite": "elder", "x": 44, "y": 16, "lines": [
    "Động Tam Thanh có tượng Phật A Di Đà khắc vào vách đá từ thời Lê.",
    "Hồn đá Tô Thị thức dậy, đá lăn khắp núi. Phải có người đủ sức mới làm nàng yên."] },
  { "id": "ls-mauson", "name": "Người Dao Mẫu Sơn", "sprite": "villager", "x": 100, "y": 20, "lines": [
    "Mẫu Sơn mùa đông có băng tuyết, mây phủ quanh năm.",
    "Đào Mẫu Sơn nở đẹp lắm, mà đá lăn làm gãy cả vườn."] },
  { "id": "ls-chilang", "name": "Người giữ ải Chi Lăng", "sprite": "elder", "x": 14, "y": 76, "lines": [
    "Ải Chi Lăng hai bên núi dựng, giữa là thung lũng hẹp.",
    "Ngày xưa quân ta phục ở đây đánh tan giặc."] },
  { "id": "ls-market", "name": "Cô bán hàng chợ Kỳ Lừa", "sprite": "girl", "x": 60, "y": 84, "lines": [
    "Chợ Kỳ Lừa họp từ thời Lê, bán đủ thứ: hồi, quế, vải thổ cẩm.",
    "Có tay buôn lậu hàng giả trà trộn vào chợ."] },
  { "id": "ls-river", "name": "Ông lái đò Kỳ Cùng", "sprite": "villager", "x": 102, "y": 60, "lines": [
    "Sông Kỳ Cùng chảy ngược lên phương Bắc, khác hẳn sông khác.",
    "Rác trôi đầy bến, cá chết nổi trắng."] }
 ],
