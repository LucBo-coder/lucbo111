 "signs": [
  { "x": 62, "y": 56, "text": ["THÀNH PHỐ HÀ TĨNH", "Đất Hồng Lam. Phía tây bắc: núi Hồng Lĩnh · Phía bắc: chùa Hương Tích · Phía đông: biển Thiên Cầm · Phía tây: rừng Vũ Quang · Phía nam: Đồng Lộc."] },
  { "x": 76, "y": 84, "text": ["NGÃ BA ĐỒNG LỘC", "Nơi mười cô gái thanh niên xung phong hy sinh năm 1968 khi giữ thông con đường ra tiền tuyến."] },
  { "x": 66, "y": 12, "text": ["CHÙA HƯƠNG TÍCH", "Hoan Châu đệ nhất danh lam, trên núi Hồng Lĩnh chín mươi chín ngọn."] }
 ],
 "npcs": [
  { "id": "ht-guide", "name": "Cô Lam Hà Tĩnh", "sprite": "girl", "x": 70, "y": 56, "lines": [
    "Chào mừng tới Hà Tĩnh! Ăn đĩa ram bánh mướt đã con.",
    "Mấy bữa nay có con đại bàng khổng lồ sà xuống bắt gà vịt cả làng.",
    "Sư chùa Hương Tích trên núi biết chuyện, con lên hỏi."] },
  { "id": "ht-monk", "name": "Sư chùa Hương Tích", "sprite": "elder", "x": 60, "y": 14, "lines": [
    "Núi Hồng Lĩnh có chín mươi chín ngọn. Truyền rằng có một trăm con chim phượng về đậu, một con bay mất.",
    "Đại bàng trên núi giận vì người ta phá rừng đầu nguồn."] },
  { "id": "ht-poet", "name": "Cụ đồ ngâm Kiều", "sprite": "elder", "x": 84, "y": 46, "lines": [
    "Trăm năm trong cõi người ta, chữ tài chữ mệnh khéo là ghét nhau...",
    "Đại thi hào Nguyễn Du quê ở Tiên Điền, ngay đất này đó con."] },
  { "id": "ht-ranger", "name": "Kiểm lâm Vũ Quang", "sprite": "ranger", "x": 20, "y": 70, "lines": [
    "Vũ Quang là nơi người ta tìm ra sao la và mang lớn lần đầu tiên.",
    "Lâm tặc chặt rừng đầu nguồn, chim thú bỏ đi hết."] },
  { "id": "ht-fisher", "name": "Ngư dân Thiên Cầm", "sprite": "villager", "x": 104, "y": 70, "lines": [
    "Thiên Cầm nghĩa là đàn trời. Gió thổi qua núi nghe như tiếng đàn.",
    "Rác trôi vô bãi nhiều quá con ơi."] },
  { "id": "ht-farmer", "name": "Chú trồng bưởi Phúc Trạch", "sprite": "farmer", "x": 56, "y": 90, "lines": [
    "Bưởi Phúc Trạch ngọt thanh, múi mọng, tiến vua ngày xưa đó.",
    "Đại bàng sà xuống vườn làm rụng hết bưởi non."] },
  { "id": "ht-dongloc", "name": "Người giữ di tích Đồng Lộc", "sprite": "elder", "x": 80, "y": 78, "lines": [
    "Mười cô gái tuổi đôi mươi nằm lại nơi này để đường thông xe.",
    "Thắp nén nhang cho các cô rồi hãy đi tiếp nha con."] }
 ],
