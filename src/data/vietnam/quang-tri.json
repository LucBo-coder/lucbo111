 "signs": [
  { "x": 64, "y": 62, "text": ["THÀNH PHỐ ĐỒNG HỚI", "Phía tây bắc: Phong Nha — Kẻ Bàng · Phía bắc: biển Nhật Lệ · Phía đông: địa đạo Vịnh Mốc · Phía nam: cầu Hiền Lương, Thành cổ."] },
  { "x": 44, "y": 82, "text": ["CẦU HIỀN LƯƠNG", "Cây cầu bắc qua sông Bến Hải, hai mươi năm chia cắt hai miền, nay là biểu tượng thống nhất."] },
  { "x": 30, "y": 14, "text": ["PHONG NHA — KẺ BÀNG", "Vương quốc hang động, có hang Sơn Đoòng lớn nhất thế giới. Di sản thiên nhiên thế giới."] }
 ],
 "npcs": [
  { "id": "qt-guide", "name": "Chú Hòa Đồng Hới", "sprite": "villager", "x": 64, "y": 54, "lines": [
    "Chào mừng tới Đồng Hới! Ăn chén cháo canh cho ấm bụng.",
    "Từ hang động Phong Nha có bầy dơi bay ra kín trời, tiếng rít inh tai cả đêm.",
    "Anh dẫn đường Phong Nha biết rõ hang, con lên hỏi."] },
  { "id": "qt-cave", "name": "Anh dẫn đường Phong Nha", "sprite": "youngster", "x": 36, "y": 26, "lines": [
    "Hang Sơn Đoòng to tới mức có cả rừng và mây bên trong.",
    "Trong hang có Dơi Thần, tiếng kêu của nó làm vỡ cả thạch nhũ."] },
  { "id": "qt-beach", "name": "Ngư dân Nhật Lệ", "sprite": "villager", "x": 96, "y": 24, "lines": [
    "Biển Nhật Lệ cát trắng, nước trong, chiều nào cũng đông người tắm.",
    "Rác nhựa trôi vô bờ nhiều quá con ơi."] },
  { "id": "qt-veteran", "name": "Cựu chiến binh Vịnh Mốc", "sprite": "elder", "x": 108, "y": 70, "lines": [
    "Ba tầng địa đạo đào bằng tay, cả làng sống dưới lòng đất mấy năm trời.",
    "Đêm nào cũng nghe tiếng dơi rít trong địa đạo, chắc từ Phong Nha bay về."] },
  { "id": "qt-bridge", "name": "Người giữ cầu Hiền Lương", "sprite": "elder", "x": 52, "y": 92, "lines": [
    "Cầu sơn hai màu, bờ bắc bờ nam ngóng nhau hai mươi năm.",
    "Giờ thống nhất rồi, cầu chỉ còn để nhớ."] },
  { "id": "qt-ranger", "name": "Kiểm lâm Trường Sơn", "sprite": "ranger", "x": 20, "y": 60, "lines": [
    "Rừng Trường Sơn có sao la, loài thú quý hiếm nhất thế giới.",
    "Bầy thợ săn đặt bẫy khắp rừng, anh gỡ không xuể."] }
 ],
