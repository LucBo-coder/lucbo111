 "npcs": [
  { "id": "hy-guide", "name": "Chị Huệ Phố Hiến", "sprite": "girl", "x": 70, "y": 60, "lines": [
    "Chào mừng tới Hưng Yên! Ăn miếng bánh cáy cho biết.",
    "Vườn nhãn lồng mùa này bị ai đá gãy cành, quả rụng đầy gốc.",
    "Bà trồng nhãn ở phía tây bắc biết chuyện, em qua hỏi."] },
  { "id": "hy-farmer", "name": "Bà trồng nhãn", "sprite": "elder", "x": 30, "y": 40, "lines": [
    "Nhãn lồng Hưng Yên ngày xưa tiến vua đó cháu, cùi dày, hạt nhỏ.",
    "Có con Pokémon cao như người, chân dài, đá một phát gãy cả cành nhãn."] },
  { "id": "hy-temple", "name": "Ông từ đền Chử Đồng Tử", "sprite": "elder", "x": 80, "y": 12, "lines": [
    "Chử Đồng Tử nghèo đến chỉ có một cái khố, vậy mà nên duyên với công chúa.",
    "Ông nghe nói con Pokémon kia tự xưng nữ hoàng vườn nhãn, đuổi hết người hái."] },
  { "id": "hy-keo", "name": "Sư chùa Keo", "sprite": "elder", "x": 20, "y": 82, "lines": [
    "Gác chuông chùa Keo đứng bốn trăm năm, gió bão không lay.",
    "Vạn vật đều có chỗ của nó. Nữ hoàng vườn nhãn giận vì người ta phun thuốc trừ sâu tràn lan."] },
  { "id": "hy-paddy", "name": "Bác nông dân Thái Bình", "sprite": "farmer", "x": 70, "y": 88, "lines": [
    "Thái Bình là quê lúa, đất chín mươi chín ngọn... à không, đồng lúa thẳng cánh cò bay.",
    "Cò về đồng ít hẳn, bác lo lắm."] },
  { "id": "hy-beach", "name": "Ngư dân Đồng Châu", "sprite": "villager", "x": 112, "y": 70, "lines": [
    "Biển Đồng Châu hoang sơ, rừng phi lao chắn gió.",
    "Rác trôi từ sông Hồng ra biển dạt hết vào đây."] },
  { "id": "hy-scholar", "name": "Cụ đồ Văn Miếu", "sprite": "elder", "x": 84, "y": 46, "lines": [
    "Văn Miếu Xích Đằng thờ Khổng Tử, nơi học trò xứ Sơn Nam về cầu thi đỗ.",
    "Phố Hiến ngày xưa là thương cảng sầm uất, thuyền buôn khắp nơi về."] }
 ],
