 "signs": [
  { "x": 62, "y": 49, "text": ["THÀNH PHỐ NHA TRANG", "Phố biển. Phía bắc: tháp Bà Ponagar · Phía đông: vịnh Nha Trang, đảo yến · Phía tây: đèo Khánh Lê, vườn nho Ninh Thuận · Phía nam: vịnh Cam Ranh."] },
  { "x": 70, "y": 14, "text": ["THÁP BÀ PONAGAR", "Đền tháp Chăm hơn ngàn năm tuổi thờ nữ thần Thiên Y A Na, mẹ xứ sở."] },
  { "x": 22, "y": 94, "text": ["THÁP PO KLONG GARAI", "Ba tháp gạch đỏ trên đồi Trầu, nơi người Chăm Ninh Thuận làm lễ Katê mỗi năm."] }
 ],
 "npcs": [
  { "id": "kh-guide", "name": "Cô Ba Nha Trang", "sprite": "girl", "x": 70, "y": 49, "lines": [
    "Chào mừng tới Nha Trang! Biển ở đây xanh nhất miền Trung đó.",
    "Mấy tuần nay biển động hoài, sóng cao dù trời không bão. Ghe không ra khơi được.",
    "Ông từ ở tháp Bà biết nhiều chuyện biển, con lên hỏi thử."] },
  { "id": "kh-cham", "name": "Ông từ tháp Bà", "sprite": "elder", "x": 68, "y": 10, "lines": [
    "Thiên Y A Na là mẹ xứ sở, dạy dân trồng lúa, dệt vải.",
    "Ngoài vịnh có Thần Biển giữ sóng. Thần giận thì sóng nổi, thuyền lật."] },
  { "id": "kh-diver", "name": "Anh thợ lặn Hòn Mun", "sprite": "youngster", "x": 103, "y": 52, "lines": [
    "Rạn san hô Hòn Mun đẹp nhất Việt Nam, mà gần đây bị lưới cào phá nhiều.",
    "Dưới đáy vịnh có cái gì xoáy nước dữ lắm, tui lặn không dám xuống sâu."] },
  { "id": "kh-swift", "name": "Chú khai thác yến", "sprite": "villager", "x": 98, "y": 18, "lines": [
    "Chim yến làm tổ trong hang đảo ngoài kia, tổ yến quý như vàng.",
    "Mùa này sóng to, tụi chú không ra đảo được."] },
  { "id": "kh-grape", "name": "Cô Nhung vườn nho", "sprite": "girl", "x": 20, "y": 66, "lines": [
    "Nho Ninh Thuận ngọt nhờ nắng gió, một năm ba vụ.",
    "Đàn cừu Phan Rang cũng nổi tiếng lắm, con ghé coi."] },
  { "id": "kh-weaver", "name": "Bà dệt thổ cẩm Mỹ Nghiệp", "sprite": "girl", "x": 14, "y": 98, "lines": [
    "Thổ cẩm Chăm dệt tay, hoa văn từ thời tổ tiên.",
    "Tháp Po Klong Garai sắp làm lễ Katê, vui lắm con."] },
  { "id": "kh-fisher", "name": "Ngư dân Cam Ranh", "sprite": "villager", "x": 78, "y": 90, "lines": [
    "Vịnh Cam Ranh kín gió nhất nước, ghe neo ở đây yên tâm.",
    "Rác nhựa trôi vô bờ nhiều quá, rùa biển ăn nhầm chết hết."] }
 ],
