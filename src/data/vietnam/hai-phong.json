 "signs": [
  { "x": 62, "y": 60, "text": ["THÀNH PHỐ HẢI PHÒNG", "Thành phố hoa phượng đỏ. Phía tây bắc: Côn Sơn — Kiếp Bạc · Phía bắc: vườn vải Thanh Hà · Phía đông: đảo Cát Bà · Phía tây: cảng · Phía nam: Đồ Sơn."] },
  { "x": 26, "y": 16, "text": ["CÔN SƠN — KIẾP BẠC", "Nơi Nguyễn Trãi ở ẩn và đền thờ Hưng Đạo Đại Vương Trần Quốc Tuấn."] },
  { "x": 108, "y": 60, "text": ["ĐẢO CÁT BÀ", "Rừng nguyên sinh trên đảo đá vôi, nhà của voọc Cát Bà — loài linh trưởng hiếm nhất Việt Nam."] }
 ],
 "npcs": [
  { "id": "hp-guide", "name": "Chị Phượng Hải Phòng", "sprite": "girl", "x": 70, "y": 60, "lines": [
    "Chào mừng tới Hải Phòng! Ăn bát bánh đa cua đã em.",
    "Mùa này hoa phượng chưa nở mà đã có lửa đỏ rực bay ngang trời, cháy cả mấy cây phượng.",
    "Kiểm lâm Cát Bà thấy nó bay về đảo, em ra hỏi."] },
  { "id": "hp-ranger", "name": "Kiểm lâm Cát Bà", "sprite": "ranger", "x": 106, "y": 40, "lines": [
    "Rừng Cát Bà khô quá, chim lửa bay qua là cháy.",
    "Nó làm tổ trên vách đá phía bắc đảo, giận dữ lắm."] },
  { "id": "hp-monk", "name": "Sư chùa Côn Sơn", "sprite": "elder", "x": 30, "y": 36, "lines": [
    "Côn Sơn suối chảy rì rầm, ta nghe như tiếng đàn cầm bên tai... thơ Nguyễn Trãi đó con.",
    "Chim lửa là chim thiêng giữ mùa hạ. Phượng chưa nở mà nó đến sớm, ắt có chuyện."] },
  { "id": "hp-lychee", "name": "Chú trồng vải Thanh Hà", "sprite": "farmer", "x": 60, "y": 16, "lines": [
    "Vải thiều Thanh Hà ngọt lịm, mùa hè bán khắp nơi.",
    "Năm nay nắng nóng bất thường, vải cháy lá hết."] },
  { "id": "hp-port", "name": "Công nhân cảng", "sprite": "villager", "x": 20, "y": 62, "lines": [
    "Cảng Hải Phòng lớn nhất miền Bắc, tàu ra vào tấp nập.",
    "Khói tàu với khói nhà máy làm trời nóng hầm hập."] },
  { "id": "hp-doson", "name": "Cô bán hải sản Đồ Sơn", "sprite": "girl", "x": 70, "y": 90, "lines": [
    "Đồ Sơn có lễ hội chọi trâu nổi tiếng nhất miền Bắc đó.",
    "Bán đảo đẹp mà rác nhiều quá."] },
  { "id": "hp-opera", "name": "Nghệ sĩ nhà hát lớn", "sprite": "elder", "x": 84, "y": 46, "lines": [
    "Nhà hát lớn xây từ thời Pháp, giờ vẫn diễn đều.",
    "Tối nay có vở cải lương, con ghé xem nha."] }
 ],
