 "signs": [
  { "x": 62, "y": 62, "text": ["THÀNH PHỐ BẮC NINH", "Quê hương quan họ. Phía tây bắc: đồi Lim · Phía bắc: Tây Yên Tử · Phía tây: làng tranh Đông Hồ · Phía nam: vải Lục Ngạn · Phía đông: chùa Dâu."] },
  { "x": 40, "y": 34, "text": ["ĐỒI LIM", "Hội Lim mùng mười ba tháng Giêng, liền anh liền chị hát quan họ trên thuyền giữa ao làng."] },
  { "x": 22, "y": 70, "text": ["LÀNG TRANH ĐÔNG HỒ", "Tranh in trên giấy điệp, màu từ lá cây, sỏi son: Đám cưới chuột, Lợn ăn cây ráy..."] }
 ],
 "npcs": [
  { "id": "bn-guide", "name": "Liền chị Thơm", "sprite": "girl", "x": 70, "y": 62, "lines": [
    "Người ơi người ở đừng về... Chào mừng tới Bắc Ninh!",
    "Mấy đêm nay ao làng Lim có tiếng hát lạ, ai nghe cũng ngủ mê, thuyền trôi mất cả.",
    "Liền anh Hai ở bờ ao biết chuyện, em qua hỏi."] },
  { "id": "bn-singer", "name": "Liền anh Hai", "sprite": "villager", "x": 30, "y": 34, "lines": [
    "Tiếng hát ấy hay lắm, hay hơn cả quan họ làng mình.",
    "Mà nghe xong ai cũng buồn ngủ, có người suýt chìm xuống ao."] },
  { "id": "bn-monk", "name": "Sư Tây Yên Tử", "sprite": "elder", "x": 100, "y": 20, "lines": [
    "Tây Yên Tử là đường vua Trần Nhân Tông lên núi tu hành.",
    "Tiếng hát dưới ao là của Nàng Quan Họ, linh vật giữ ao làng. Nàng buồn vì làng bỏ hát, chỉ mở loa."] },
  { "id": "bn-painter", "name": "Nghệ nhân tranh Đông Hồ", "sprite": "elder", "x": 20, "y": 74, "lines": [
    "Tranh Đông Hồ in bằng ván gỗ, mỗi màu một ván.",
    "Có bức tranh cổ vẽ nàng tiên cá hát trên ao Lim đó con."] },
  { "id": "bn-lychee", "name": "Chú trồng vải Lục Ngạn", "sprite": "farmer", "x": 70, "y": 90, "lines": [
    "Vải thiều Lục Ngạn mùa hè đỏ rực cả đồi.",
    "Mấy đứa hái vải đêm nào cũng ra ao Lim nghe hát, sáng ra ngủ gục."] },
  { "id": "bn-pagoda", "name": "Sư chùa Dâu", "sprite": "elder", "x": 112, "y": 76, "lines": [
    "Chùa Dâu là ngôi chùa cổ nhất Việt Nam, gần hai ngàn năm tuổi.",
    "Phật pháp vào nước ta đầu tiên ở đất Luy Lâu này."] }
 ],
