 "signs": [
  { "x": 62, "y": 56, "text": ["THÀNH PHỐ VINH", "Thành phố bên dòng sông Lam. Phía tây bắc: rừng Pù Mát · Phía bắc: đảo chè Thanh Chương · Phía đông: biển Cửa Lò · Phía tây: làng Sen · Phía nam: Quỳ Châu."] },
  { "x": 22, "y": 62, "text": ["LÀNG SEN", "Quê nội của Chủ tịch Hồ Chí Minh ở Kim Liên. Ao sen trước ngõ, nhà tranh mái lá."] },
  { "x": 76, "y": 22, "text": ["ĐẢO CHÈ THANH CHƯƠNG", "Hàng chục quả đồi chè nổi giữa hồ, như những hòn đảo xanh."] }
 ],
 "npcs": [
  { "id": "na-guide", "name": "O Hoa xứ Nghệ", "sprite": "girl", "x": 70, "y": 56, "lines": [
    "Chào mừng tới Vinh! Ăn bát súp lươn cho ấm bụng nghe.",
    "Mấy đêm ni trong rừng Pù Mát có tiếng cú kêu rợn người, mũi tên lá bay ra cắm đầy đường.",
    "Kiểm lâm Pù Mát biết chuyện, con lên hỏi."] },
  { "id": "na-ranger", "name": "Kiểm lâm Pù Mát", "sprite": "ranger", "x": 36, "y": 30, "lines": [
    "Pù Mát là rừng nguyên sinh lớn nhất Bắc Trung Bộ.",
    "Có Cú Thần giữ rừng, bắn mũi tên lá vào lâm tặc. Giờ hắn bắn cả người đi đường."] },
  { "id": "na-tea", "name": "Cô hái chè Thanh Chương", "sprite": "girl", "x": 60, "y": 20, "lines": [
    "Đi thuyền giữa các đảo chè, mát lắm nghe.",
    "Mấy bữa ni lá chè bị mũi tên lá cắt rụng cả."] },
  { "id": "na-sen", "name": "Cụ bà làng Sen", "sprite": "elder", "x": 22, "y": 66, "lines": [
    "Làng Sen mùa hè hoa nở thơm cả xóm.",
    "Ngày xưa ông bà dặn: rừng là mẹ, ai phá rừng thì thần rừng giận."] },
  { "id": "na-gem", "name": "Thợ đá quý Quỳ Châu", "sprite": "hiker", "x": 60, "y": 90, "lines": [
    "Quỳ Châu có hồng ngọc, đá quý đẹp nhất nước.",
    "Người ta đào bới tràn lan, đất lở xuống cả suối."] },
  { "id": "na-fisher", "name": "Ngư dân Cửa Lò", "sprite": "villager", "x": 104, "y": 70, "lines": [
    "Biển Cửa Lò cát mịn, sóng êm, mực nháy tươi ngon nhất.",
    "Rác trôi vô bãi nhiều quá, khách chê hoài."] },
  { "id": "na-singer", "name": "Nghệ nhân ví giặm", "sprite": "elder", "x": 84, "y": 46, "lines": [
    "Dân ca ví giặm xứ Nghệ là di sản thế giới đó con.",
    "Ai ơi về miền ví giặm, nghe câu hò mà nhớ quê..."] }
 ],
