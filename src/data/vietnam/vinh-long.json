 "signs": [
  {
   "x": 74,
   "y": 54,
   "text": [
    "BẾN VĨNH LONG",
    "Thành phố nằm bên sông Cổ Chiên, nơi tách ra từ sông Tiền. Phía bắc: bến đò ra Cù lao An Bình · Phía tây: Văn Thánh Miếu, ruộng khoai Bình Tân, đường về Cần Thơ · Phía nam: lò gạch Mang Thít, vườn bưởi Bình Minh."
   ]
  },
  {
   "x": 54,
   "y": 47,
   "text": [
    "VĂN THÁNH MIẾU",
    "Miếu thờ Khổng Tử và các bậc hiền nho, xây từ thời nhà Nguyễn, nay là di tích của Vĩnh Long.",
    "Xin giữ yên lặng khi vào miếu."
   ]
  },
  {
   "x": 78,
   "y": 27,
   "text": [
    "CÙ LAO AN BÌNH",
    "Cù lao giữa sông Tiền và sông Cổ Chiên, nổi tiếng với vườn trái cây và nhà vườn đón khách.",
    "Đò ra cù lao ở bến phía trước."
   ]
  },
  {
   "x": 34,
   "y": 82,
   "text": [
    "LÒ GẠCH MANG THÍT",
    "Hàng trăm lò gạch, lò gốm dọc kênh Mang Thít — người ta gọi nơi đây là \"vương quốc gốm đỏ\".",
    "(Thần Lò trong game là sinh vật giả tưởng.)"
   ]
  },
  {
   "x": 83,
   "y": 77,
   "text": [
    "VƯỜN BƯỞI BÌNH MINH",
    "Bình Minh là quê của bưởi Năm Roi ngọt thanh, mọng nước."
   ]
  },
  {
   "x": 20,
   "y": 48,
   "text": [
    "RUỘNG KHOAI BÌNH TÂN",
    "Đất cát pha ven sông hợp trồng khoai lang. ↑ Bờ sông Tiền · → Bến Vĩnh Long · ← Đường về Cần Thơ"
   ]
  }
 ],
