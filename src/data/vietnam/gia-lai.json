 "signs": [
  { "x": 62, "y": 52, "text": ["THÀNH PHỐ PLEIKU", "Phố núi cao. Phía tây bắc: Biển Hồ · Phía bắc: núi lửa Chư Đăng Ya · Phía đông bắc: võ đường Tây Sơn · Phía đông nam: biển Quy Nhơn."] },
  { "x": 100, "y": 20, "text": ["VÕ ĐƯỜNG TÂY SƠN", "Quê hương ba anh em Tây Sơn. Võ Bình Định nổi tiếng: 'Roi Thuận Truyền, quyền An Vinh'."] },
  { "x": 112, "y": 88, "text": ["EO GIÓ", "Vịnh đá hình cánh cung ôm lấy biển, nơi ngắm hoàng hôn đẹp nhất Quy Nhơn."] }
 ],
 "npcs": [
  { "id": "gl-guide", "name": "Anh Rơ Châm", "sprite": "villager", "x": 60, "y": 60, "lines": [
    "Chào mừng tới Pleiku, phố núi cao, phố núi đầy sương!",
    "Mấy bữa nay đá trên núi lửa lăn xuống, đường bị chắn hết.",
    "Cô hướng dẫn ở Biển Hồ biết chuyện, con ghé hỏi."] },
  { "id": "gl-lake", "name": "Cô hướng dẫn Biển Hồ", "sprite": "girl", "x": 40, "y": 26, "lines": [
    "Biển Hồ là miệng núi lửa cũ, nước trong quanh năm, Pleiku uống nước hồ này.",
    "Người ta đồn có võ sĩ khổng lồ vác cột đá đi khắp núi."] },
  { "id": "gl-volcano", "name": "Kiểm lâm Chư Đăng Ya", "sprite": "ranger", "x": 82, "y": 22, "lines": [
    "Mùa hoa dã quỳ, núi lửa vàng rực một màu.",
    "Ai đó đập vỡ vách đá bazan rồi vác đi, để lại dấu chân to tướng."] },
  { "id": "gl-master", "name": "Võ sư già Tây Sơn", "sprite": "elder", "x": 98, "y": 30, "lines": [
    "Võ Bình Định có từ thời Tây Sơn, đánh bằng quyền, bằng côn, bằng roi.",
    "Có một Pokémon học lén võ đường mấy trăm năm, giờ thành Võ Thần, vác cột đá thách đấu khắp nơi."] },
  { "id": "gl-tea", "name": "Chị hái chè Biển Hồ", "sprite": "girl", "x": 14, "y": 80, "lines": [
    "Đồi chè Biển Hồ có hàng thông trăm tuổi đứng giữa, đẹp như tranh.",
    "Đá lăn xuống đè nát mấy luống chè rồi."] },
  { "id": "gl-forest", "name": "Kiểm lâm Kon Ka Kinh", "sprite": "ranger", "x": 56, "y": 90, "lines": [
    "Kon Ka Kinh có voọc chà vá chân xám, quý hiếm lắm.",
    "Bầy rắn lạ kéo về rừng, đám khỉ sợ hết dám xuống."] },
  { "id": "gl-quynhon", "name": "Ngư dân Quy Nhơn", "sprite": "villager", "x": 106, "y": 96, "lines": [
    "Biển Quy Nhơn sóng êm, cát trắng, ghe thúng chèo ra tận Kỳ Co.",
    "Rác trôi từ sông về biển nhiều lắm con."] }
 ],
