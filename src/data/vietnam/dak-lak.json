 "signs": [
  { "x": 62, "y": 58, "text": ["THÀNH PHỐ BUÔN MA THUỘT", "Thủ phủ cà phê. Phía bắc: Buôn Đôn · Phía tây bắc: rừng Yok Đôn · Phía đông: thác Dray Nur, biển Phú Yên · Phía nam: hồ Lắk."] },
  { "x": 76, "y": 18, "text": ["BUÔN ĐÔN", "Xứ săn voi, thuần voi của người M'nông, Ê Đê, Lào. Cầu treo bắc qua sông Sêrêpốk."] },
  { "x": 114, "y": 88, "text": ["GÀNH ĐÁ ĐĨA", "Những cột đá bazan xếp như chồng đĩa, do dung nham nguội đột ngột bên bờ biển Phú Yên."] }
 ],
 "npcs": [
  { "id": "dl-guide", "name": "Chị H'Linh", "sprite": "girl", "x": 66, "y": 58, "lines": [
    "Chào mừng tới Buôn Ma Thuột! Ghé uống ly cà phê đã.",
    "Mấy đêm nay voi rừng phá buôn làng, giẫm nát rẫy cà phê.",
    "Anh quản tượng ở Buôn Đôn hiểu voi nhất, con lên hỏi thử."] },
  { "id": "dl-mahout", "name": "Anh quản tượng Y Khu", "sprite": "villager", "x": 82, "y": 18, "lines": [
    "Voi nhà tui cũng bồn chồn, đêm nào cũng rống về phía rừng.",
    "Ông bà nói trong rừng Yok Đôn có Voi Thần giữ rừng."] },
  { "id": "dl-elder", "name": "Già làng M'nông", "sprite": "elder", "x": 64, "y": 12, "lines": [
    "Tiếng cồng chiêng gọi thần linh về giữ buôn làng.",
    "Rừng bị chặt, Voi Thần không còn chỗ ở thì phải nổi giận."] },
  { "id": "dl-farmer", "name": "Chú Ba rẫy cà phê", "sprite": "farmer", "x": 18, "y": 80, "lines": [
    "Cà phê Robusta ở đây đậm nhất nước đó con.",
    "Voi giẫm nát nửa rẫy rồi, mà tui không nỡ đuổi."] },
  { "id": "dl-ranger", "name": "Kiểm lâm Yok Đôn", "sprite": "ranger", "x": 40, "y": 30, "lines": [
    "Yok Đôn là rừng khộp lớn nhất nước, mùa khô lá rụng vàng cả rừng.",
    "Lâm tặc vào chặt gỗ, đặt bẫy thú. Voi con mắc bẫy hoài."] },
  { "id": "dl-lakeman", "name": "Ông lái thuyền độc mộc", "sprite": "villager", "x": 50, "y": 90, "lines": [
    "Thuyền độc mộc đẽo từ một thân cây, đi trên hồ Lắk êm lắm.",
    "Khách du lịch xả rác xuống hồ nhiều quá."] },
  { "id": "dl-falls", "name": "Anh hướng dẫn Dray Nur", "sprite": "youngster", "x": 104, "y": 26, "lines": [
    "Dray Nur là thác vợ, Dray Sáp là thác chồng. Chuyện tình buồn lắm.",
    "Có người đứng trên vách đá thách đấu khách hoài."] },
  { "id": "dl-ganh", "name": "Chị bán cá ngừ Phú Yên", "sprite": "girl", "x": 106, "y": 96, "lines": [
    "Cá ngừ đại dương Phú Yên nổi tiếng khắp nơi.",
    "Có anh thanh niên đứng trên gành đá thách đấu, khách sợ không dám xuống."] }
 ],
